generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
    provider = "postgresql"
}

model AdminUser {
    id           String   @id @default(cuid())
    email        String   @unique
    passwordHash String
    failedAttempts Int       @default(0)
    lockedUntil    DateTime?
    createdAt    DateTime @default(now())
    updatedAt    DateTime @updatedAt 
}

enum ProductTag {
    SOB_ENCOMENDA
    ACABA_RAPIDO
    ESGOTADO
    PROMOCAO
}

model Product {
    id              String        @id @default(cuid())
    title           String
    description     String
    priceCents      Int
    promoPriceCents Int?
    tags            ProductTag[]
    active          Boolean       @default(true)
    images          ProductImage[]
    createdAt       DateTime      @default(now())
    updatedAt       DateTime      @updatedAt
}

model ProductImage {
    id        String   @id @default(cuid())
    url       String
    order     Int
    product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
    productId String
}

enum GalleryCategory {
    PORTFOLIO
    PAINTING
    COVERUP
}

model GalleryImage {
    id        String          @id @default(cuid())
    url       String
    category  GalleryCategory
    order     Int
    createdAt DateTime        @default(now())
}